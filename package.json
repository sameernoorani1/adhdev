  "author": "Sameer Noorani <github.com/sameernoorani1>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/sameernoorani1/adhdev#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sameernoorani1/adhdev.git"
  },
  "bugs": {
    "url": "https://github.com/sameernoorani1/adhdev/issues"
  },
  "bin": {
    "adhdev": "./cli/index.mjs"
  },
  "files": [
    "cli",
    "server",
    "public",
    ".next/standalone",
    ".next/static",
    ".next/server",
    ".next/BUILD_ID",
    ".next/build-manifest.json",
    ".next/prerender-manifest.json",
    ".next/routes-manifest.json",
    ".next/required-server-files.json",
    ".next/app-build-manifest.json",
    ".next/app-path-routes-manifest.json",
    ".next/images-manifest.json",
    ".next/react-loadable-manifest.json",
    "next.config.mjs",
    "tsconfig.json",
    "ADHDEV.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev -p 3111",
    "dev:full": "node server/terminal.mjs & next dev -p 3111",
    "terminal": "node server/terminal.mjs",
    "build": "next build",
    "start": "next start -p 3111",
